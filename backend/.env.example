# Local MongoDB database. MongoDB creates this database after its first write.
MONGODB_URI=mongodb://127.0.0.1:27017/ecafehimachal

# Use a long, unique random string. Never commit your real value.
JWT_SECRET=replace_with_a_long_random_secret

# The frontend address allowed to call this API during local development.
FRONTEND_URL=http://localhost:5173
PORT=5000

# Used later by the secure admin seed command. Never add a real password to Git.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-seeding

# Digits only, including country code. Used later for WhatsApp links.
ADMIN_WHATSAPP_NUMBER=918920302813

# Added in the payment phase. Keep the secret backend-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NODE_ENV=development
